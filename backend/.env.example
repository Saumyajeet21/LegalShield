# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Groq LLM
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional upgraded verification (apply migration 002 first)
LAVEN_ENHANCED=false
LAVEN_VERIFIER_PATH=
LAVEN_CALIBRATION_PATH=
LAVEN_REGENERATION_ATTEMPTS=1
LAVEN_SAMPLE_COUNT=1
LAVEN_ANSWER_TIMEOUT=55
LAVEN_MAX_ENTROPY=1.0
LAVEN_RESEARCH_INDEX=
LAVEN_RECONSTRUCTION_PATH=
